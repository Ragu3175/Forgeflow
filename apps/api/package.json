    "test:lb": "tsx test/load-balancer.test.ts",
    "test:obs": "tsx test/observability.test.ts",
    "test:metrics": "tsx test/prometheus-metrics.test.ts",
    "test:grafana": "tsx test/grafana.test.ts",
    "test:tracing": "tsx test/distributed-tracing.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeflow/shared": "*",
    "amqplib": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
