# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/forgeflow
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forgeflow

# Redis Connection (Cache / State store)
# Local: redis://localhost:6379 | Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# RabbitMQ Connection (Message Queue)
# Local: amqp://guest:guest@localhost:5672 | Docker: amqp://guest:guest@rabbitmq:5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT Secret for Signing Tokens
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
